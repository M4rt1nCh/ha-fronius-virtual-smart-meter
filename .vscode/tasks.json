{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start Home Assistant",
        "type": "shell",
        "command": "supervisor_run",
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "new"
        },
        "problemMatcher": []
      },
      {
        "label": "Lint (ruff check)",
        "type": "shell",
        "command": "ruff check .",
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        },
        "problemMatcher": []
      },
      {
        "label": "Format (ruff format)",
        "type": "shell",
        "command": "ruff format .",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        },
        "problemMatcher": []
      }
    ]
  }
